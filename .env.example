# Copy this file to .env and fill in the values before starting the server.
# The .env file is loaded automatically when you run `npm start` (via dotenv).
#
# IMPORTANT: Never commit your .env file — it is listed in .gitignore.

# ── Llama API key (Meta AI) ────────────────────────────────────────────────
# Required for the "AI Facts" feature (/api/ai-facts endpoint).
#
# How to obtain your key:
#   1. Go to https://llama.developer.meta.com/ and sign in with a Meta account.
#   2. Create a new application / project.
#   3. Copy the API key shown in the dashboard.
#   4. Paste it below (replace the placeholder).
#
# Without this key the /api/ai-facts endpoint returns HTTP 503 and the
# "Discover Facts" button in the UI will show an error message.
META_AI_API_KEY=your_llama_api_key_here

# ── HTTP / HTTPS ports ─────────────────────────────────────────────────────
# Defaults: 3000 (HTTP) and 3443 (HTTPS). Uncomment to override.
# PORT=3000
# HTTPS_PORT=3443

# ── TLS certificate (optional) ─────────────────────────────────────────────
# When these are unset the server auto-generates a self-signed certificate
# (suitable for local development). For production, supply real certificate
# paths (e.g. from Let's Encrypt).
# SSL_CERT_FILE=/etc/letsencrypt/live/example.com/fullchain.pem
# SSL_KEY_FILE=/etc/letsencrypt/live/example.com/privkey.pem
